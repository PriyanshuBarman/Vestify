generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  password       String?
  pin            String?
  hasPin         Boolean           @default(false)
  role           Role              @default(USER)
  balance        Decimal           @default(0) @db.Decimal(18, 2)
  lastRewardedAt DateTime?
  authProvider   AuthProviderType? // e.g. "google", "facebook", etc. Null if using email/password auth

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile                Profile?
  sessions               Session[]
  mfPortfolios           MfPortfolio[]
  mfHoldings             MfHolding[]
  mfWatchlists           MfWatchlist[]
  mfOrders               MfOrder[]
  mfSips                 MfSip[]
  stockOrders            StockOrder[]
  pendingMfSipChanges    PendingMfSipChange[]
  transactions           Transaction[]           @relation("UserTransactions")
  peerTransactions       Transaction[]           @relation("PeerTransactions")
  resetPasswordToken     ResetPasswordToken?
  emailChangeRequest     EmailChangeRequest?
  referrals              Referral[]              @relation("UserReferrals")
  referredBy             Referral?               @relation("ReferredUser")
  announcementDismissals AnnouncementDismissal[]
  stockPortfolios        StockPortfolio[]
  stockHoldings          StockHolding[]
  stockWatchlists        StockWatchlist[]

  @@map("users")
}

enum AuthProviderType {
  GOOGLE
  FACEBOOK
  GITHUB
  TWITTER
}

enum Role {
  ADMIN
  USER
}

model Referral {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User   @relation("UserReferrals", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  referredUser   User   @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  referredUserId String @unique

  @@index([userId])
  @@map("referrals")
}

model Profile {
  id       String  @id @default(uuid())
  name     String
  username String  @unique
  avatar   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@map("profiles")
}

model Session {
  id               String   @id @default(uuid())
  refreshTokenHash String   @unique
  userAgent        String
  ip               String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("sessions")
}

model ResetPasswordToken {
  id        String   @id @default(uuid())
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@index([token])
  @@map("reset_password_tokens")
}

model EmailChangeRequest {
  id        String   @id @default(uuid())
  newEmail  String
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@index([userId])
  @@map("email_change_requests")
}

model Transaction {
  id             String          @id @default(uuid())
  amount         Decimal         @db.Decimal(18, 2)
  note           String?
  type           TransactionType
  updatedBalance Decimal         @db.Decimal(18, 2)
  createdAt      DateTime        @default(now())

  // Wallet owner
  user   User   @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // For Peer-to-peer transactions
  peerUser   User?   @relation("PeerTransactions", fields: [peerUserId], references: [id], onDelete: SetNull)
  peerUserId String?

  // For Asset-based transactions
  assetCategory AssetCategory?
  mfOrder       MfOrder?       @relation(fields: [assetOrderId], references: [id], onDelete: Cascade)
  assetOrderId  String?        @unique

  stockOrder   StockOrder? @relation(fields: [stockOrderId], references: [id], onDelete: Cascade)
  stockOrderId String?     @unique

  @@map("transactions")
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum AssetCategory {
  MUTUAL_FUND
  GOLD
  STOCK
}

// ----------------------------------------------
// MUTUAL FUND 
// ----------------------------------------------

model MfOrder {
  id              String      @id @default(uuid())
  schemeCode      Int
  fundName        String
  fundShortName   String
  fundHouseDomain String
  fundType        FundType
  type            MfOrderType
  status          MfOrderStatus      @default(PENDING)
  amount          Decimal?    @db.Decimal(18, 2)
  units           Decimal?    @db.Decimal(36, 18)
  method          TnxMethod   @default(REGULAR)
  sipId           String?
  processDate     DateTime    @db.Date
  navDate         DateTime    @db.Date
  nav             Decimal?    @db.Decimal(10, 4)
  failureReason   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  transaction Transaction?

  @@index([userId, schemeCode])
  @@map("mf_orders")
}

enum TnxMethod {
  REGULAR
  SIP
  SWP
}

enum MfOrderStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MfOrderType {
  ONE_TIME
  REDEEM
  SIP_INSTALLMENT
  NEW_SIP
}

model MfPortfolio {
  folio            Int      @id @default(autoincrement()) @db.UnsignedInt
  schemeCode       Int
  fundName         String
  fundShortName    String
  fundType         FundType
  fundHouseDomain  String // it's need to get fund logo
  units            Decimal  @db.Decimal(36, 18)
  invested         Decimal  @db.Decimal(18, 2)
  current          Decimal  @db.Decimal(18, 2)
  pnl              Decimal  @default(0.00) @db.Decimal(18, 2)
  returnPercent    Decimal  @default(0.00) @db.Decimal(8, 2)
  dayChangePercent Decimal? @default(0.00) @db.Decimal(5, 2)
  dayChangeValue   Decimal? @default(0) @db.Decimal(10, 2)
  nav              Json // latest nav info
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sips     MfSip[]
  holdings MfHolding[]

  @@unique([userId, schemeCode])
  @@index([userId])
  @@map("mf_portfolios")
}

enum FundType {
  EQUITY
  DEBT
  HYBRID
  OTHERS
  SOLUTION_ORIENTED
}

model MfHolding {
  id         String   @id @default(uuid())
  schemeCode Int
  nav        Decimal  @db.Decimal(10, 4) // purchase/redeem nav
  units      Decimal  @db.Decimal(36, 18) // purchase/redeem units
  amount     Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  portfolio MfPortfolio @relation(fields: [folio], references: [folio], onDelete: Cascade)
  folio     Int         @db.UnsignedInt

  @@index([userId, schemeCode])
  @@map("mf_holdings")
}

model MfSip {
  id                  String   @id @default(uuid())
  sipDate             Int
  nextInstallmentDate DateTime @db.Date
  fundName            String
  fundShortName       String
  fundCategory        String
  fundType            FundType
  schemeCode          Int
  amount              Decimal  @db.Decimal(18, 2)
  fundHouseDomain     String
  failedCount         Int      @default(0) @db.UnsignedInt

  // step-up sip fields
  nextStepUpDate         DateTime? @db.Date
  stepUpAmount           Decimal?  @db.Decimal(18, 2)
  stepUpPercentage       Decimal?  @db.Decimal(18, 2)
  stepUpIntervalInMonths Int?      @db.UnsignedInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  portfolio MfPortfolio? @relation(fields: [folio], references: [folio], onDelete: SetNull)
  folio     Int?         @db.UnsignedInt

  pendingChanges PendingMfSipChange[]

  @@index([userId, schemeCode])
  @@map("mf_sips")
}

model PendingMfSipChange {
  id                  String    @id @default(uuid())
  amount              Decimal?  @db.Decimal(18, 2) // future amount
  sipDate             Int?
  nextInstallmentDate DateTime? @db.Date
  applyDate           DateTime  @db.Date // when these changes should be applied
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sip    MfSip  @relation(fields: [sipId], references: [id], onDelete: Cascade)
  sipId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, sipId])
  @@map("pending_mf_sip_changes")
}

model MfWatchlist {
  id              String   @id @default(uuid())
  schemeCode      Int
  fundShortName   String
  fundName        String
  fundHouseDomain String
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, schemeCode])
  @@map("mf_watchlists")
}

// ----------------------------------------------
// STOCK 
// ----------------------------------------------

model StockOrder {
  id          String           @id @default(uuid())
  symbol      String
  name        String
  shortName   String
  type        StockOrderType // REGULAR, SL, GTT
  productType ProductType      @default(DELIVERY)
  action      StockOrderAction // BUY, SELL
  status      StockOrderStatus @default(OPEN)

  amount       Decimal? @db.Decimal(18, 2)
  quantity     Int?
  price        Decimal? @db.Decimal(10, 4)
  triggerPrice Decimal? @db.Decimal(10, 4)
  limitPrice   Decimal? @db.Decimal(10, 4)

  validity  StockOrderValidity @default(DAY_END)
  expiresAt DateTime?          @db.Date
  gttType   GttType?

  executedAt DateTime?

  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  transaction Transaction?

  @@index([status])
  @@index([expiresAt])
  @@index([userId, symbol])
  @@map("stock_orders")
}

enum StockOrderStatus {
  OPEN
  SUCCESSFUL
  UNSUCCESSFUL
  CANCELLED
}

enum StockOrderType {
  REGULAR
  SL
  GTT
}

enum GttType {
  TARGET
  STOP_LOSS
}

enum ProductType {
  DELIVERY
}

enum StockOrderAction {
  BUY
  SELL
}

enum StockOrderValidity {
  DAY_END
  YEAR
}

model StockPortfolio {
  id        String   @id @default(uuid())
  symbol    String
  name      String
  shortName String
  quantity  Int
  invested  Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  holdings StockHolding[]

  @@unique([userId, symbol])
  @@index([userId])
  @@map("stock_portfolios")
}

model StockHolding {
  id        String   @id @default(uuid())
  symbol    String
  price     Decimal  @db.Decimal(10, 4) // purchase/redeem price
  quantity  Int // purchase/redeem quantity
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  portfolio   StockPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId String

  @@index([userId, symbol])
  @@map("stock_holdings")
}

model StockWatchlist {
  id        String   @id @default(uuid())
  symbol    String
  name      String
  shortName String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, symbol])
  @@map("stock_watchlists")
}

// ----------------------------------------------
// ANNOUNCEMENT 
// ----------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  message   String   @db.Text
  linkUrl   String?
  linkLabel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dismissals AnnouncementDismissal[]

  @@index([createdAt])
  @@map("announcements")
}

model AnnouncementDismissal {
  id             String   @id @default(cuid())
  userId         String
  announcementId String
  dismissedAt    DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@map("announcement_dismissals")
}
